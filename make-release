#!/usr/bin/env opsh

RUNDIR=$PWD

lib::import git

VERSION=$(git::repo::version)
RELEASENAME="opsh-$VERSION"
ARCHIVENAME="$RELEASENAME.tar.gz"
: "${RELEASEDIR:=$TMPDIR/$RELEASENAME}"
: "${BUILD_ARCHIVE:=true}"

mkdir -p "$RELEASEDIR"

log::info "installing to $RELEASENAME..."
for i in bin share; do mkdir -p "${RELEASEDIR}/$i"; done
cp bin/opsh "${RELEASEDIR}/bin/."
cp -r share/* "${RELEASEDIR}/share/."

cat <<EOF >"${RELEASEDIR}/share/opsh/common.opsh"
_OPSH_VERSION="$VERSION"
EOF
cat share/opsh/common.opsh >>"${RELEASEDIR}/share/opsh/common.opsh"

if $BUILD_ARCHIVE; then
    log::info "making archive $ARCHIVENAME..."
    (cd "$RELEASEDIR/.." && tar cvzf "$RUNDIR/$ARCHIVENAME" "$RELEASENAME")
fi

log::info "done making release"
